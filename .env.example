# Konfiguracja środowiska TwojeKorzenie (Bezpieczny szablon - bez kluczy prywatnych)
# UWAGA BEZPIECZEŃSTWA: Nigdy nie umieszczaj tajnych kluczy API (np. service_role) z prefiksem VITE_!
# Klucze prywatne muszą znajdować się wyłącznie po stronie backendu (poza przeglądarką).

VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_twoj_klucz_publiczny
# Opcjonalny klucz publiczny Google Maps JS / Places API (ograniczony po domenie HTTP Referrer)
VITE_GOOGLE_MAPS_API_KEY=

VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=production
VITE_DEBUG_MODE=false
VITE_ENABLE_RATE_LIMIT=true
VITE_SESSION_TIMEOUT_MINUTES=30
